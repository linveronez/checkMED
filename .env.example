# Origins autorizadas a chamar a API, separadas por vírgula e sem barra final.
CHECKMED_FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://SEU-USUARIO.github.io

# Connection string PostgreSQL do Neon (preferir a URL com pooler).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BASE?sslmode=require

# Use uma base/branch separada para testes de integração.
TEST_DATABASE_URL=postgresql://USUARIO:SENHA@HOST_TESTE/BASE_TESTE?sslmode=require

# Gere um segredo aleatório longo para limitar tentativas.
SECRET_KEY=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
SESSION_DAYS=30
MAX_PAYLOAD_BYTES=1048576
RECOVERY_CODE_TTL_MINUTES=30
